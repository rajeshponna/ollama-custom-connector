{
  "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name": "Ollama Chat",
  "id": "io.camunda.connectors.OllamaChat.v1",
  "version": 4,
  "description": "Call a local or remote Ollama model and use its response to drive process decisions.",
  "documentationRef": "https://docs.ollama.com/api",
  "category": {
    "id": "connectors",
    "name": "Connectors"
  },
  "appliesTo": [
    "bpmn:Task"
  ],
  "elementType": {
    "value": "bpmn:ServiceTask"
  },
  "groups": [
    {
      "id": "connection",
      "label": "Connection"
    },
    {
      "id": "prompt",
      "label": "Prompt"
    },
    {
      "id": "output",
      "label": "Output"
    },
    {
      "id": "outputMapping",
      "label": "Output mapping"
    },
    {
      "id": "error",
      "label": "Error handling"
    },
    {
      "id": "retries",
      "label": "Retries"
    }
  ],
  "properties": [
    {
      "value": "io.camunda:ollama-chat:1",
      "binding": {
        "property": "type",
        "type": "zeebe:taskDefinition"
      },
      "type": "Hidden"
    },
    {
      "value": "chat",
      "binding": {
        "key": "operationId",
        "type": "zeebe:taskHeader"
      },
      "type": "Hidden"
    },
    {
      "label": "Base URL",
      "description": "Ollama API root. Use http://host.docker.internal:11435 for local Ollama.",
      "value": "http://host.docker.internal:11434",
      "feel": "optional",
      "group": "connection",
      "binding": {
        "name": "baseUrl",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "type": "String"
    },
    {
      "label": "Model",
      "description": "Model tag as shown by 'ollama list', e.g. mistral:latest",
      "feel": "optional",
      "group": "connection",
      "binding": {
        "name": "model",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "type": "String"
    },
    {
      "label": "System prompt",
      "description": "Instructions/role for the model. Optional.",
      "optional": true,
      "feel": "optional",
      "group": "prompt",
      "binding": {
        "name": "systemPrompt",
        "type": "zeebe:input"
      },
      "type": "Text"
    },
    {
      "label": "User prompt",
      "description": "The task/question for the model. Supports FEEL expressions.",
      "feel": "optional",
      "group": "prompt",
      "binding": {
        "name": "userPrompt",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "type": "Text"
    },
    {
      "label": "Temperature",
      "description": "0.0 - 1.0. Lower is more deterministic.",
      "value": 0.7,
      "feel": "static",
      "group": "prompt",
      "binding": {
        "name": "temperature",
        "type": "zeebe:input"
      },
      "type": "Number"
    },
    {
      "label": "Response format",
      "description": "Plain text or json parsed into decision map.",
      "value": "text",
      "feel": "optional",
      "group": "output",
      "binding": {
        "name": "responseFormat",
        "type": "zeebe:input"
      },
      "type": "String"
    },
    {
      "label": "Timeout (seconds)",
      "description": "HTTP timeout for Ollama response.",
      "value": 60,
      "feel": "static",
      "group": "output",
      "binding": {
        "name": "timeoutSeconds",
        "type": "zeebe:input"
      },
      "type": "Number"
    },
    {
      "label": "Result variable",
      "description": "Process variable name to store the result.",
      "value": "ollamaResult",
      "group": "outputMapping",
      "binding": {
        "key": "resultVariable",
        "type": "zeebe:taskHeader"
      },
      "type": "String"
    },
    {
      "label": "Result expression",
      "description": "FEEL expression to map result into process variables.",
      "feel": "required",
      "optional": true,
      "group": "outputMapping",
      "binding": {
        "key": "resultExpression",
        "type": "zeebe:taskHeader"
      },
      "type": "Text"
    },
    {
      "label": "Error expression",
      "description": "FEEL expression to handle errors.",
      "feel": "required",
      "optional": true,
      "group": "error",
      "binding": {
        "key": "errorExpression",
        "type": "zeebe:taskHeader"
      },
      "type": "Text"
    },
    {
      "label": "Retries",
      "value": "3",
      "feel": "optional",
      "group": "retries",
      "binding": {
        "property": "retries",
        "type": "zeebe:taskDefinition"
      },
      "type": "String"
    },
    {
      "label": "Retry backoff",
      "description": "ISO-8601 duration to wait between retries.",
      "value": "PT0S",
      "group": "retries",
      "binding": {
        "key": "retryBackoff",
        "type": "zeebe:taskHeader"
      },
      "type": "String"
    }
  ],
  "icon": {
    "contents": "data:image/svg+xml;base64,"
  }
}